{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["shim/**/*.mjs", "scripts/**/*.mjs", "src/**/*.mjs", "test/merge.test.mjs", "test/config-check.test.mjs", "test/picker.test.mjs", "test/freshness.test.mjs", "test/render.test.mjs"]
}
