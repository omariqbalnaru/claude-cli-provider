#!/usr/bin/env bash
# claude-shim — manage the Anthropic-wire server backed by Claude Code.
#
#   claude-shim start     boot it (idempotent)
#   claude-shim stop      shut it down
#   claude-shim status    health + model count
#   claude-shim logs      tail its log
#   claude-shim models <providers-json|models-yml|models-json|opencode> [port]
#                         render this catalog as a harness config
#   claude-shim config merge opencode [--dry-run] [--config PATH]
#                         merge the opencode block into an OpenCode config
#
# Auth comes from Claude Code's own Keychain entry — the shim spawns the
# official `claude` CLI, which owns authentication.
# This never reads, extracts, or replays an OAuth token.
set -euo pipefail

# npm installs bins as symlinks, so resolve the link before taking dirname —
# otherwise HERE points at node_modules/.bin and the shim path misses.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  TARGET="$(readlink "$SOURCE")"
  case "$TARGET" in
    /*) SOURCE="$TARGET" ;;
    *) SOURCE="$(dirname "$SOURCE")/$TARGET" ;;
  esac
done
HERE="$(cd "$(dirname "$SOURCE")" && pwd)"
SHIM_DIR="$HERE/../shim"
PORT="${CLAUDE_SHIM_PORT:-8792}"
LOG="${CLAUDE_SHIM_LOG:-${TMPDIR:-/tmp}/claude-shim.log}"
export CLAUDE_SHIM_PORT="$PORT"

require_node() {
  command -v node >/dev/null || { echo "claude-shim requires Node.js on PATH (Bun cannot cancel disconnected turns)" >&2; exit 1; }
  node -e 'const p=Number(process.argv[1]);if(!Number.isInteger(p)||p<1||p>65535){console.error("CLAUDE_SHIM_PORT must be an integer from 1 to 65535");process.exit(1)}' "$PORT"
}

require_lsof() {
  command -v lsof >/dev/null || { echo "claude-shim requires lsof on PATH" >&2; exit 1; }
}

healthy() {
  curl -fsS --max-time 1 "http://127.0.0.1:$PORT/healthz" 2>/dev/null |
    node -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>{try{const h=JSON.parse(s);process.exit(h.ok===true&&Number.isSafeInteger(h.conversations)&&h.conversations>=0?0:1)}catch{process.exit(1)}})'
}

listener_pid() {
  local pids
  pids="$(lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null || true)"
  printf '%s\n' "${pids%%$'\n'*}"
}

case "${1:-start}" in
  models)
    require_node
    exec node "$SHIM_DIR/server.mjs" models "${2:-providers-json}" "${3:-$PORT}"
    ;;
  config)
    require_node
    if [ "${2:-}" != "merge" ] || [ "${3:-}" != "opencode" ]; then
      echo "usage: claude-shim config merge opencode [--dry-run] [--config PATH]" >&2
      exit 2
    fi
    # Drop "config merge opencode": the target is fixed, so only the flags
    # that follow are for the merge command.
    shift 3
    exec node "$SHIM_DIR/merge.mjs" opencode --port "$PORT" "$@"
    ;;
  start)
    require_node
    require_lsof
    if [ -n "$(listener_pid)" ]; then
      if healthy; then
        echo "claude-shim already listening on :$PORT"
        exit 0
      fi
      echo "port :$PORT is occupied by an unhealthy or non-shim listener; refusing to start" >&2
      exit 1
    fi
    echo "starting claude-shim on :$PORT ..."
    # Detach with a real login environment (Keychain auth needs it), and keep
    # the log private: the shim logs conversation metadata.
    umask 077
    (
      cd "$SHIM_DIR"
      export USER="${USER:-$(id -un)}" LOGNAME="${LOGNAME:-$(id -un)}"
      export SHELL="${SHELL:-/bin/sh}" TMPDIR="${TMPDIR:-/tmp}"
      exec nohup node server.mjs >>"$LOG" 2>&1
    ) &
    pid=$!
    for _ in $(seq 40); do
      if healthy; then
        echo "claude-shim up: http://127.0.0.1:$PORT/v1"
        exit 0
      fi
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.25
    done
    echo "shim failed to come up; see $LOG" >&2
    exit 1
    ;;
  stop)
    require_node
    require_lsof
    pid="$(listener_pid)"
    if [ -n "$pid" ]; then
      if ! healthy; then
        echo "listener on :$PORT is not a healthy claude-shim; refusing to stop pid $pid" >&2
        exit 1
      fi
      echo "stopping claude-shim (pid $pid)"
      kill "$pid" 2>/dev/null || true
    else
      echo "nothing listening on :$PORT"
    fi
    ;;
  status)
    require_node
    if healthy; then
      echo "claude-shim :$PORT -> up"
      curl -fsS --max-time 2 "http://127.0.0.1:$PORT/v1/models" \
        | node -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>console.log("models exposed:",JSON.parse(s).data.length))'
    else
      echo "claude-shim :$PORT -> DOWN"
      exit 1
    fi
    ;;
  logs)
    tail -n 40 -f "$LOG"
    ;;
  *)
    echo "usage: claude-shim {start|stop|status|logs|models <providers-json|models-yml|models-json|opencode> [port]}" >&2
    exit 2
    ;;
esac
